# Copy to .env.local and fill in. .env.local is git-ignored.
# Higgsfield API credentials in key-id:key-secret format (https://cloud.higgsfield.ai).
HF_KEY=
# tools/characters/image2rig.py: a Hugging Face read token (spelled out so it cannot be mistaken for the Higgsfield key above) for ZeroGPU Spaces, and a Tripo API key.
# HUGGINGFACE_TOKEN=hf_...     (HF_TOKEN also works, but other Hugging Face tools read that name: prefer this one)
# TRIPO_API_KEY=tsk_...
# TENCENT_HY3D_KEY=sk-...        (Tencent's Hunyuan 3D platform: texture, rigging, retopology, parts; tools/characters/image2rig.py)
