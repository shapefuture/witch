			"polarity": "+",
			"roles": ["question", "answer"],
			"constraints": {"delay_min": 1, "same_reaction": true}
		},
		"revision": {
			"model": "m.hall.every_poke_answered",
			"deeper_model": "m.hall.latest_poke_answered",
			"exception": "echo.exception.latest_wins",
			"teaches": {"key": "rule.hall.echo.teaches"}
		},
		"exceptions": [
			{
				"id": "echo.exception.latest_wins",
				"polarity": "+",
				"scope": "a second touch before the first has been answered",
				"teaches": {"key": "rule.hall.echo.teaches"}
			}
		],
		"variants": [
