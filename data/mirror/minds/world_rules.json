					"model_effects": [{"type": "ensure", "rule_id": "m.hall.every_poke_answered", "subject_id": "hall", "proposition": {"hall": "answers_every_poke"}, "scope": "hall", "confidence": 0.4, "status": "HYPOTHESIS"}]
				},
