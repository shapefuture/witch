	{
		"id": "rule.hall.echo",
		"_about": "TEMPORAL. The hall answers late: what you touch, it repeats, with the same move, after a pause. Surfaces: two props answering each other (physical), the raccoon repeating the witch (social). Boundary: the hall only remembers the latest touch.",
		"label_key": "rule.hall.echo.name",
		"statement": {"key": "rule.hall.echo.statement"},
		"domain": "temporal",
		"learnable": true,
		"major": true,
